---
import site from '../../site.config.js';
import Icon from './Icon.astro';
import SearchBox from './SearchBox.astro';
import { withBase, isActive } from '../lib/content.js';
import { tagConfig } from '../lib/queries.js';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const navIcons = { '/about/': 'person', '/contact/': 'mail', '/tags/': 'sell', ...Object.fromEntries(tagConfig.pages.map((p) => [`/${p.path}/`, p.icon])) };
const onSearchPage = isActive('/search/', path);
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={withBase('/', base)}>{site.title}</a>
    <nav class="nav" aria-label="Main">
      {site.nav.map((item) => (
        <a href={withBase(item.href, base)} aria-current={isActive(item.href, path) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    {!onSearchPage && <div class="bar-search"><SearchBox /></div>}
    <div class="bar-actions">
      <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span class="menu-open"><Icon name="menu" size={24} /></span>
        <span class="menu-close" hidden><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
    {site.nav.map((item) => (
      <a href={withBase(item.href, base)} aria-current={isActive(item.href, path) ? 'page' : undefined}><Icon name={navIcons[item.href] || 'chevron_right'} size={24} />{item.label}</a>
    ))}
  </nav>
</header>

<script>
  const btn = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    btn.querySelector('.menu-open').hidden = open;
    btn.querySelector('.menu-close').hidden = !open;
    menu.hidden = !open;
  });
</script>

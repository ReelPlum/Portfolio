---
import site from '../../site.config.js';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase, isActive } from '../lib/content.js';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const navIcons = { '/projects/': 'folder-code', '/blog/': 'pen-line', '/about/': 'user', '/contact/': 'mail' };
const design = site.design;
---
{design === 'studio' ? (
  <aside class="sidebar" aria-label="Site">
    <a class="sidebar-brand" href={withBase('/', base)}>
      <span class="avatar" aria-hidden="true">{site.author.charAt(0)}</span>
      <span><strong>{site.title}</strong><small>{site.tagline}</small></span>
    </a>
    <nav class="sidebar-nav">
      <a href={withBase('/', base)} aria-current={path === '/' ? 'page' : undefined}><span class="nav-icon"><Icon name="home" size={18} /></span>Home</a>
      {site.nav.map((item) => (
        <a href={withBase(item.href, base)} aria-current={isActive(item.href, path) ? 'page' : undefined}>
          <span class="nav-icon"><Icon name={navIcons[item.href] || 'chevron-right'} size={18} /></span>{item.label}
        </a>
      ))}
    </nav>
    <div class="sidebar-foot">
      {site.social.map((s) => <a class="icon-btn" href={s.href} aria-label={s.label}><Icon name={s.icon} size={18} /></a>)}
      <ThemeToggle />
    </div>
  </aside>
) : (
  <header class="site-header">
    <div class="bar">
      <a class="brand" href={withBase('/', base)}>{site.title}</a>
      <nav class="nav" aria-label="Main">
        {site.nav.map((item) => (
          <a href={withBase(item.href, base)} aria-current={isActive(item.href, path) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
      <div class="bar-actions">
        <ThemeToggle />
        <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <Icon name="menu" size={18} />
        </button>
      </div>
    </div>
    <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile" hidden>
      {site.nav.map((item) => (
        <a href={withBase(item.href, base)} aria-current={isActive(item.href, path) ? 'page' : undefined}>{item.label}<Icon name="chevron-right" size={18} /></a>
      ))}
    </nav>
  </header>
)}

<script>
  const btn = document.querySelector('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    menu.hidden = !open;
  });
</script>

---
import site from '../../site.config.js';
import Icon from './Icon.astro';
import { withBase } from '../lib/content.js';
import { linkAttrs } from '../lib/links.js';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const social = site.social || [];
---
<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {year} {site.author}</p>
    {social.length > 0 && (
      <nav class="footer-social" aria-label="Social">
        {social.map((s) => (
          <a class="icon-btn" href={s.href} title={s.label} aria-label={`${s.label} (opens in a new tab)`} {...linkAttrs(s.href)}>
            <Icon name={s.icon || 'link'} size={20} />
          </a>
        ))}
      </nav>
    )}
    <nav class="footer-links" aria-label="Footer">
      <a href={withBase('/rss.xml', base)}><Icon name="rss_feed" size={20} />RSS</a>
      {site.source && <a href={site.source} {...linkAttrs(site.source)}><Icon name="code" size={18} />Source</a>}
    </nav>
  </div>
</footer>

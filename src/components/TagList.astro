---
// A post's tags. Each one links to its page when it has one (see `tags` in site.config.js).
import { withBase } from '../lib/content.js';
import { tagHref } from '../lib/tags.js';
import { tagConfig } from '../lib/queries.js';
const { tags = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
---
{tags.length > 0 && (
  <span class="tags">
    {tags.map((t) => {
      const href = tagHref(t, tagConfig);
      return href ? <a class="tag tag-link" href={withBase(href, base)}>{t}</a> : <span class="tag">{t}</span>;
    })}
  </span>
)}

---
import Icon from './Icon.astro';
import { withBase } from '../lib/content.js';
import { demoReady, demoExamples } from '../lib/demo.js';
const { demo, title } = Astro.props;
const base = import.meta.env.BASE_URL;
const ready = demoReady(demo);
const examples = demoExamples(demo);
const url = demo.type === 'wasi' ? withBase(demo.wasm, base) : demo.type === 'bindgen' ? withBase(demo.module, base) : withBase(demo.src, base);
const config = JSON.stringify({ ...demo, url });
---
<section class="playground" aria-label={`${title} playground`}>
  {!ready ? (
    <div class="playground-soon">
      <Icon name="terminal" size={36} />
      <h3>Playground coming soon</h3>
      <p>The live demo will appear here once the build is added.</p>
    </div>
  ) : demo.type === 'iframe' ? (
    <iframe class="playground-frame" src={url} title={`${title} demo`} style={`height:${demo.height}px`} loading="lazy" sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
  ) : (
    <div class="playground-app" data-playground={config}>
      <div class="playground-toolbar">
        <span class="playground-label"><Icon name="terminal" size={20} />Playground</span>
        {examples.length > 1 && (
          <label class="playground-examples">
            <span class="visually-hidden">Example</span>
            <select data-pg-examples>
              {examples.map((e, i) => <option value={i}>{e.name}</option>)}
            </select>
          </label>
        )}
        <span class="playground-spacer"></span>
        <button class="icon-btn" type="button" data-pg-reset aria-label="Reset code" title="Reset"><Icon name="restart_alt" size={20} /></button>
        <button class="icon-btn" type="button" data-pg-copy aria-label="Copy code" title="Copy">
          <span class="pg-copy-icon"><Icon name="content_copy" size={20} /></span>
          <span class="pg-check-icon" hidden><Icon name="check" size={20} /></span>
        </button>
        <button class="btn" type="button" data-pg-run><Icon name="play_arrow" size={20} />Run</button>
      </div>
      <label class="visually-hidden" for={`pg-${title}`}>Code</label>
      <textarea id={`pg-${title}`} class="playground-editor" data-pg-editor spellcheck="false" autocapitalize="off" autocomplete="off">{examples[0]?.code ?? ''}</textarea>
      <div class="playground-console" data-pg-output aria-live="polite" role="log"><span class="pg-hint">Press Run or ⌘/Ctrl + Enter</span></div>
    </div>
  )}
</section>

<script>
  import { loadModule, runWasi, runBindgen } from '../lib/wasi-runner.js';
  import { demoExamplesClient } from '../lib/playground-client.js';

  for (const root of document.querySelectorAll('[data-playground]')) {
    const cfg = JSON.parse(root.dataset.playground);
    const editor = root.querySelector('[data-pg-editor]');
    const out = root.querySelector('[data-pg-output]');
    const runBtn = root.querySelector('[data-pg-run]');
    const select = root.querySelector('[data-pg-examples]');
    const examples = demoExamplesClient(cfg);
    let current = 0;

    const animateIcon = (btn) => {
      const icon = btn.querySelector('.icon');
      icon?.classList.remove('is-animating');
      void icon?.getBoundingClientRect();
      icon?.classList.add('is-animating');
    };

    const line = (text, cls) => {
      const el = document.createElement('div');
      el.className = cls;
      el.textContent = text;
      out.append(el);
    };

    async function run() {
      runBtn.disabled = true;
      animateIcon(runBtn);
      out.replaceChildren();
      const started = performance.now();
      try {
        const onLine = ({ stream, text }) => line(text, stream === 'err' ? 'pg-err' : 'pg-out');
        const result = cfg.type === 'wasi'
          ? await runWasi(await loadModule(cfg.url), { code: editor.value, input: cfg.input, filename: cfg.filename, args: cfg.args, onLine })
          : await runBindgen(cfg.url, { code: editor.value, entry: cfg.entry, onLine });
        const ms = Math.round(performance.now() - started);
        line(`${result.exitCode === 0 ? '✓' : '✕'} exited with code ${result.exitCode} in ${ms} ms`, result.exitCode === 0 ? 'pg-meta' : 'pg-meta pg-meta-err');
      } catch (e) {
        line(String(e?.message || e), 'pg-err');
      } finally {
        runBtn.disabled = false;
      }
    }

    runBtn.addEventListener('click', run);
    editor.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) { e.preventDefault(); run(); }
      if (e.key === 'Tab' && !e.shiftKey) {
        e.preventDefault();
        const { selectionStart: s, selectionEnd: end } = editor;
        editor.setRangeText('  ', s, end, 'end');
      }
    });
    select?.addEventListener('change', () => { current = Number(select.value); editor.value = examples[current]?.code ?? ''; });
    root.querySelector('[data-pg-reset]').addEventListener('click', (e) => {
      animateIcon(e.currentTarget);
      editor.value = examples[current]?.code ?? '';
      out.replaceChildren();
    });
    root.querySelector('[data-pg-copy]').addEventListener('click', async (e) => {
      const btn = e.currentTarget;
      try { await navigator.clipboard.writeText(editor.value); } catch { return; }
      const [copy, check] = [btn.querySelector('.pg-copy-icon'), btn.querySelector('.pg-check-icon')];
      copy.hidden = true; check.hidden = false;
      animateIcon(check);
      btn.setAttribute('aria-label', 'Copied');
      setTimeout(() => { copy.hidden = false; check.hidden = true; btn.setAttribute('aria-label', 'Copy code'); }, 1600);
    });
  }
</script>

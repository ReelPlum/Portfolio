---
import Icon from './Icon.astro';
import { withBase } from '../lib/content.js';
const { title, href, linkLabel = 'See all' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<div class="section-header">
  <h2>{title}</h2>
  {href && <a class="see-all" href={withBase(href, base)}>{linkLabel}<Icon name="chevron-right" size={16} /></a>}
</div>

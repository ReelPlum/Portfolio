---
// One post. Projects are posts too: a `demo` adds the playground, `source` and `link` add buttons.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Playground from '../Playground.astro';
import Icon from '../Icon.astro';
import Backlinks from '../Backlinks.astro';
import Toc from '../Toc.astro';
import TagList from '../TagList.astro';
import Picture from '../Picture.astro';
import Byline from '../Byline.astro';
import Share from '../Share.astro';
import History from '../History.astro';
import StatusBadge from '../StatusBadge.astro';
import { pageOf } from '../../lib/queries.js';
import { summaryOf } from '../../lib/tags.js';
import { ogImagePath } from '../../lib/og.js';
import { withBase, formatDate, readingTime, updatedDate } from '../../lib/content.js';
import { blogPostingLd, projectLd } from '../../lib/seo.js';
import site from '../../../site.config.js';
import { linkAttrs } from '../../lib/links.js';

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, date, tags, demo, source, link, cover, draft, status } = post.data;
const updated = updatedDate(post.data);
const description = summaryOf(post) || undefined;
const page = pageOf(post);
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const image = cover && new URL(withBase(cover, base), Astro.site).href;
const isProject = Boolean(demo || source || link || status);
const ld = isProject
  ? projectLd({ title, summary: description, date, updated, url, source, tags, image, author: site.author })
  : blogPostingLd({ title, description, date, updated, url, image, author: site.author });
const key = `posts/${post.id}`;
---
<Base title={title} description={description} image={cover || ogImagePath(key)} type="article" published={date} modified={updated} jsonLd={[ld]}>
  <article class:list={['article article--wide', { 'article--project': isProject }]}>
    <header class="article-header">
      <a class="back-link" href={withBase(page ? `/${page.path}/` : '/', base)}><Icon name="arrow_back" size={18} />{page ? page.title : 'Home'}</a>
      {draft && <p class="draft-badge">Draft: only visible in <code>npm run dev</code></p>}
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      <Byline entry={post} />
    </header>
    <aside class="article-aside">
      <div class="meta">
        <StatusBadge status={status} />
        <span><Icon name="calendar_today" size={16} /><time datetime={date.toISOString()}>{formatDate(date)}</time></span>
        {updated && <span class="meta-updated"><Icon name="update" size={16} />Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
        <span><Icon name="schedule" size={16} />{readingTime(post.body)} min read</span>
        <TagList tags={tags} />
      </div>
      {(source || link) && (
        <div class="article-actions">
          {link && <a class="btn" href={link} {...linkAttrs(link)}><Icon name="open_in_new" size={18} />Visit</a>}
          {source && <a class="btn btn-tonal" href={source} {...linkAttrs(source)}><Icon name="github" size={16} />View source</a>}
        </div>
      )}
      <Share url={url} title={title} />
      <Toc headings={headings} />
    </aside>
    <div class="article-main">
      {demo && <Playground demo={demo} title={title} />}
      {!demo && cover && <Picture class="article-cover" src={cover} sizes="(min-width: 1600px) 880px, (min-width: 800px) 780px, 100vw" eager />}
      <div class="prose">
        <Content />
      </div>
      <Backlinks id={key} />
      <History file={post.filePath} />
      <section class="related" data-related={key}></section>
    </div>
  </article>
</Base>

---
import Icon from './Icon.astro';
import { withBase, formatDate } from '../lib/content.js';
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p) => withBase(p.collection === 'projects' ? `/projects/${p.id}/` : `/blog/${p.id}/`, base);
---
<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a class="post-row" href={href(post)} data-icon-trigger>
        <span class="post-row-icon"><Icon name={post.collection === 'projects' ? 'code' : 'article'} size={20} /></span>
        <span class="post-row-text">
          <span class="post-row-title">{post.data.title}</span>
          {(post.data.description || post.data.summary) && <span class="post-row-desc">{post.data.description || post.data.summary}</span>}
        </span>
        {post.data.date && <span class="post-row-date">{formatDate(post.data.date)}</span>}
        <Icon name="chevron_right" size={20} />
      </a>
    </li>
  ))}
</ul>

---
import Icon from './Icon.astro';
import { withBase, formatDate } from '../lib/content.js';
import { urlOf, pageOf } from '../lib/queries.js';
import { summaryOf } from '../lib/tags.js';
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a class="post-row" href={withBase(urlOf(post), base)} data-icon-trigger>
        <span class="post-row-icon"><Icon name={pageOf(post)?.icon || 'article'} size={20} /></span>
        <span class="post-row-text">
          <span class="post-row-title">{post.data.title}</span>
          {summaryOf(post) && <span class="post-row-desc">{summaryOf(post)}</span>}
        </span>
        {post.data.date && <span class="post-row-date">{formatDate(post.data.date)}</span>}
        <Icon name="chevron_right" size={20} />
      </a>
    </li>
  ))}
</ul>

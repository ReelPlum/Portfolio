---
import Icon from './Icon.astro';
---
<button class="icon-btn theme-toggle" type="button" aria-label="Switch to dark mode" data-theme-toggle>
  <span class="theme-icon theme-icon-dark"><Icon name="dark_mode" size={22} /></span>
  <span class="theme-icon theme-icon-light"><Icon name="light_mode" size={22} /></span>
</button>

<style>
  .theme-icon { display: contents; }
  :global(:root[data-theme='light']) .theme-icon-light,
  :global(:root[data-theme='dark']) .theme-icon-dark { display: none; }
</style>

<script>
  import { nextTheme, writeStored } from '../lib/theme.js';
  for (const btn of document.querySelectorAll('[data-theme-toggle]')) {
    const sync = () => {
      const t = document.documentElement.dataset.theme;
      btn.setAttribute('aria-label', t === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
      btn.setAttribute('aria-pressed', String(t === 'dark'));
    };
    sync();
    btn.addEventListener('click', () => {
      const t = nextTheme(document.documentElement.dataset.theme);
      document.documentElement.dataset.theme = t;
      writeStored(t);
      document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.dispatchEvent(new Event('theme-sync')));
      // play the newly shown icon's animation
      const icon = btn.querySelector(t === 'dark' ? '.theme-icon-light .icon' : '.theme-icon-dark .icon');
      icon?.classList.remove('is-animating');
      void icon?.getBoundingClientRect();
      icon?.classList.add('is-animating');
    });
    btn.addEventListener('theme-sync', sync);
  }
</script>

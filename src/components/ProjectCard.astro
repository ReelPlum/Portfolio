---
import Icon from './Icon.astro';
import StatusBadge from './StatusBadge.astro';
import Picture from './Picture.astro';
import { withBase } from '../lib/content.js';
const { project, size = 'normal' } = Astro.props;
const base = import.meta.env.BASE_URL;
const { title, summary, tags, cover, demo, status } = project.data;
const href = withBase(`/projects/${project.id}/`, base);
---
<article class={`project-card project-card--${size}`}>
  <a href={href} class="project-card-link" data-icon-trigger>
    {cover && <div class="project-card-media"><Picture src={cover} sizes={size === 'large' ? '(min-width: 900px) 60vw, 100vw' : '(min-width: 900px) 33vw, 100vw'} /></div>}
    <div class="project-card-body">
      {status && <StatusBadge status={status} />}
      <h3>{title}</h3>
      <p class="project-card-summary">{summary}</p>
      <div class="project-card-foot">
        {tags.length > 0 && <div class="tags">{tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}</div>}
        <span class="project-card-cta">{demo ? 'Try it' : 'Open'}<Icon name={demo ? 'play_arrow' : 'arrow_forward'} size={18} /></span>
      </div>
    </div>
  </a>
</article>

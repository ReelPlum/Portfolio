---
import site from '../../site.config.js';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { ldJson, absolute } from '../lib/seo.js';
import '@fontsource-variable/roboto-flex';
import 'katex/dist/katex.min.css';
import '../styles/base.css';
import '../styles/icons.css';
import '../styles/site.css';

const { title, description = site.description, image, type = 'website', published, jsonLd = [], noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const ogImage = image ? absolute(image.startsWith('/') && !image.startsWith(base) ? base.replace(/\/$/, '') + image : image, Astro.site) : null;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={`${base}rss.xml`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content={site.author} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {published && <meta property="article:published_time" content={new Date(published).toISOString()} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={ldJson(d)} />)}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131314" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="container">
      <slot />
    </main>
    <SiteFooter />
    <script>
      // Only pages with an embedded PDF download the PDF renderer.
      if (document.querySelector('[data-pdf]')) import('../lib/pdf-viewer.js').then((m) => m.renderAllPdfs());
      // 3D models and WebAssembly canvas apps load their code only on pages that have one.
      if (document.querySelector('[data-model]')) import('@google/model-viewer');
      if (document.querySelector('[data-canvas]')) import('../lib/canvas-embed.js').then((m) => m.setupCanvases());
      // Copy buttons on code blocks.
      document.addEventListener('click', async (event) => {
        const btn = event.target.closest?.('.code-copy');
        if (!btn) return;
        const code = btn.closest('.code-block')?.querySelector('pre code');
        const status = btn.parentElement.querySelector('.code-status');
        try {
          await navigator.clipboard.writeText(code?.innerText ?? '');
          btn.classList.add('is-copied');
          btn.setAttribute('aria-label', 'Copied');
          if (status) status.textContent = 'Copied to clipboard';
          setTimeout(() => {
            btn.classList.remove('is-copied');
            btn.setAttribute('aria-label', 'Copy code');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          if (status) status.textContent = 'Copying is blocked in this browser';
        }
      });
    </script>
  </body>
</html>

---
import site from '../../site.config.js';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Icon from '../components/Icon.astro';
import { ldJson, absolute } from '../lib/seo.js';
import { goatcounterUrl } from '../lib/analytics.js';
import { ogImagePath } from '../lib/og.js';
import '@fontsource-variable/roboto-flex';
// Preloaded so text is drawn in the right font from the start, instead of shifting when it arrives.
import robotoFlexUrl from '@fontsource-variable/roboto-flex/files/roboto-flex-latin-wght-normal.woff2?url';
import 'katex/dist/katex.min.css';
import '../styles/base.css';
import '../styles/icons.css';
import '../styles/site.css';

const { title, description = site.description, image, type = 'website', published, modified, jsonLd = [], noindex = false } = Astro.props;
// GoatCounter: privacy-friendly counts, only on the built site and only when a site code is set.
const goatcounter = import.meta.env.PROD ? goatcounterUrl(site.goatcounter) : null;
const fullTitle = title ? `${title} · ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
// Every page has a preview image: the post's cover, its generated card, or the site's card (src/lib/og.js).
const ogImage = image ? absolute(image.startsWith('/') && !image.startsWith(base) ? base.replace(/\/$/, '') + image : image, Astro.site) : absolute(base.replace(/\/$/, '') + ogImagePath(null), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="preload" href={robotoFlexUrl} as="font" type="font/woff2" crossorigin />
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={`${base}rss.xml`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content={site.author} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    {!image || ogImage.includes('/og/') ? <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></> : null}
    {published && <meta property="article:published_time" content={new Date(published).toISOString()} />}
    {modified && <meta property="article:modified_time" content={new Date(modified).toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={ldJson(d)} />)}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131314" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    {goatcounter && (
      <script is:inline data-goatcounter={goatcounter} async src="https://gc.zgo.at/count.js"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" class="container">
      <slot />
    </main>
    <SiteFooter />
    <template id="ui-icons"><Icon name="close" /><Icon name="chevron_left" /><Icon name="chevron_right" /></template>
    <script>
      import { whenNear, setupVideoFacades } from '../lib/lazy-client.js';
      const all = (selector) => document.querySelectorAll(selector);
      // Heavy code (the PDF renderer, the 3D viewer, diagrams) loads only on pages that need it, and only
      // when the embed comes close to the screen.
      whenNear(all('[data-pdf]'), () => import('../lib/pdf-viewer.js').then((m) => m.renderAllPdfs()));
      whenNear(all('[data-model]'), () => import('@google/model-viewer'));
      // YouTube and Vimeo load nothing until play is pressed.
      if (document.querySelector('[data-video-embed]')) setupVideoFacades();
      if (document.querySelector('.prose')) import('../lib/post-client.js').then((m) => { m.setupAnchors(); m.setupDiffs(); m.setupCompare(); m.setupLightbox(); });
      if (document.querySelector('[data-live-vars]')) import('../lib/live-vars-client.js').then((m) => m.setupLiveVars());
      whenNear(all('[data-mermaid]'), () => import('../lib/mermaid-client.js').then((m) => m.renderMermaid()));
      if (document.querySelector('[data-canvas]')) import('../lib/canvas-embed.js').then((m) => m.setupCanvases());
      // Copy buttons on code blocks.
      document.addEventListener('click', async (event) => {
        const btn = event.target.closest?.('.code-copy');
        if (!btn) return;
        const code = btn.closest('.code-block')?.querySelector('pre code');
        const status = btn.parentElement.querySelector('.code-status');
        try {
          await navigator.clipboard.writeText(code?.innerText ?? '');
          btn.classList.add('is-copied');
          btn.setAttribute('aria-label', 'Copied');
          if (status) status.textContent = 'Copied to clipboard';
          setTimeout(() => {
            btn.classList.remove('is-copied');
            btn.setAttribute('aria-label', 'Copy code');
            if (status) status.textContent = '';
          }, 2000);
        } catch {
          if (status) status.textContent = 'Copying is blocked in this browser';
        }
      });
    </script>
  </body>
</html>

---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Backlinks from '../../components/Backlinks.astro';
import Toc from '../../components/Toc.astro';
import Byline from '../../components/Byline.astro';
import Share from '../../components/Share.astro';
import History from '../../components/History.astro';
import { getPosts } from '../../lib/queries.js';
import { ogImagePath } from '../../lib/og.js';
import { withBase, formatDate, readingTime, updatedDate } from '../../lib/content.js';
import { blogPostingLd } from '../../lib/seo.js';
import site from '../../../site.config.js';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, cover, draft } = post.data;
const updated = updatedDate(post.data);
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = blogPostingLd({ title, description, date, updated, url, image: cover && new URL(withBase(cover, base), Astro.site).href, author: site.author });
---
<Base title={title} description={description} image={cover || ogImagePath(`blog/${post.id}`)} type="article" published={date} modified={updated} jsonLd={[ld]}>
  <article class="article article--wide">
    <header class="article-header">
      <a class="back-link" href={withBase('/blog/', base)}><Icon name="arrow_back" size={18} />Blog</a>
      {draft && <p class="draft-badge">Draft: only visible in <code>npm run dev</code></p>}
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
      <Byline entry={post} />
    </header>
    <aside class="article-aside">
      <div class="meta">
        <span><Icon name="calendar_today" size={16} /><time datetime={date.toISOString()}>{formatDate(date)}</time></span>
        {updated && <span class="meta-updated"><Icon name="update" size={16} />Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></span>}
        <span><Icon name="schedule" size={16} />{readingTime(post.body)} min read</span>
        {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>}
      </div>
      <Share url={url} title={title} />
      <Toc headings={headings} />
    </aside>
    <div class="article-main">
      {cover && <img class="article-cover" src={withBase(cover, base)} alt="" />}
      <div class="prose">
        <Content />
      </div>
      <Backlinks id={`blog/${post.id}`} />
      <History file={post.filePath} />
      <section class="related" data-related={`blog/${post.id}`}></section>
    </div>
  </article>
</Base>

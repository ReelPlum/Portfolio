---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/queries.js';
import { withBase, formatDate, readingTime } from '../../lib/content.js';
import { blogPostingLd } from '../../lib/seo.js';
import site from '../../../site.config.js';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, tags, cover } = post.data;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = blogPostingLd({ title, description, date, url, image: cover && new URL(withBase(cover, base), Astro.site).href, author: site.author });
---
<Base title={title} description={description} image={cover} type="article" published={date} jsonLd={[ld]}>
  <article class="article">
    <header class="article-header">
      <a class="back-link" href={withBase('/blog/', base)}><Icon name="arrow-left" size={16} />Blog</a>
      <h1 data-reveal>{title}</h1>
      {description && <p class="lede" data-reveal>{description}</p>}
      <div class="meta" data-reveal>
        <span><Icon name="calendar" size={15} />{formatDate(date)}</span>
        <span>{readingTime(post.body)} min read</span>
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>
    {cover && <img class="article-cover" src={withBase(cover, base)} alt="" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

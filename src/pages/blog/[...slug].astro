---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Backlinks from '../../components/Backlinks.astro';
import Toc from '../../components/Toc.astro';
import { getPosts } from '../../lib/queries.js';
import { withBase, formatDate, readingTime } from '../../lib/content.js';
import { blogPostingLd } from '../../lib/seo.js';
import site from '../../../site.config.js';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, cover } = post.data;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = blogPostingLd({ title, description, date, url, image: cover && new URL(withBase(cover, base), Astro.site).href, author: site.author });
---
<Base title={title} description={description} image={cover} type="article" published={date} jsonLd={[ld]}>
  <article class="article article--wide">
    <header class="article-header">
      <a class="back-link" href={withBase('/blog/', base)}><Icon name="arrow_back" size={18} />Blog</a>
      <h1>{title}</h1>
      {description && <p class="lede">{description}</p>}
    </header>
    <aside class="article-aside">
      <div class="meta">
        <span><Icon name="calendar_today" size={16} />{formatDate(date)}</span>
        <span><Icon name="schedule" size={16} />{readingTime(post.body)} min read</span>
        {tags.length > 0 && <span class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</span>}
      </div>
      <Toc headings={headings} />
    </aside>
    <div class="article-main">
      {cover && <img class="article-cover" src={withBase(cover, base)} alt="" />}
      <div class="prose">
        <Content />
      </div>
      <Backlinks id={`blog/${post.id}`} />
    </div>
  </article>
</Base>

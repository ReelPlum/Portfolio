---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/queries.js';
const posts = await getPosts();
---
<Base title="Blog" description="Notes and write-ups.">
  <header class="page-header">
    <h1>Blog</h1>
    <p class="lede">Notes on building things.</p>
  </header>
  {posts.length ? <PostList posts={posts} /> : <p class="empty">Nothing here yet.</p>}
</Base>

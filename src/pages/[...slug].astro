---
// Every address that comes from content:
//   src/content/pages/about.md        -> /about/
//   each page in `tags.pages`          -> /projects/, /blog/, ...
//   src/content/posts/interpreter.md  -> /projects/interpreter/ (under the first page it is on) or /posts/<name>/
import { getCollection } from 'astro:content';
import PostView from '../components/views/PostView.astro';
import FeedView from '../components/views/FeedView.astro';
import MarkdownPageView from '../components/views/MarkdownPageView.astro';
import { getAllPosts, tagConfig, urlOf } from '../lib/queries.js';
import { pagePosts, RESERVED_PATHS } from '../lib/tags.js';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  const feeds = tagConfig.pages.map((page) => ({ params: { slug: page.path }, props: { kind: 'feed', page, posts: pagePosts(posts, page) } }));
  const taken = new Set([...RESERVED_PATHS, ...tagConfig.pages.map((p) => p.path)]);
  const pages = (await getCollection('pages'))
    .filter((page) => {
      if (page.id === 'contact') return false; // has its own page in src/pages/contact.astro
      if (taken.has(page.id)) throw new Error(`src/content/pages/${page.id}.md has the same address as a page in site.config.js tags.pages, rename one of them`);
      return true;
    })
    .map((page) => ({ params: { slug: page.id }, props: { kind: 'page', page } }));
  const entries = posts.map((post) => ({ params: { slug: urlOf(post).replace(/^\/|\/$/g, '') }, props: { kind: 'post', post } }));
  return [...feeds, ...pages, ...entries];
}
const props = Astro.props;
---
{props.kind === 'post' && <PostView post={props.post} />}
{props.kind === 'feed' && <FeedView title={props.page.title} description={props.page.description} posts={props.posts} layout={props.page.layout} />}
{props.kind === 'page' && <MarkdownPageView page={props.page} />}

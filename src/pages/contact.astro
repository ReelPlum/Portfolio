---
// Contact links come from site.config.js (email + social). Optional intro text: src/content/pages/contact.md
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import site from '../../site.config.js';
import { contactLinks } from '../lib/contact.js';
import { linkAttrs } from '../lib/links.js';
const intro = await getEntry('pages', 'contact');
const Content = intro ? (await render(intro)).Content : null;
const links = contactLinks(site);
---
<Base title={intro?.data.title ?? 'Contact'} description={intro?.data.description ?? `Get in touch with ${site.author}.`}>
  <article class="article">
    <header class="article-header">
      <h1>{intro?.data.title ?? 'Contact'}</h1>
      {intro?.data.description && <p class="lede">{intro.data.description}</p>}
    </header>
    {Content && <div class="prose"><Content /></div>}
    <ul class="contact-list">
      {links.map((l) => (
        <li>
          <a class="contact-row" href={l.href} {...linkAttrs(l.href)} data-icon-trigger>
            <span class="contact-icon"><Icon name={l.icon} size={20} /></span>
            <span class="contact-text"><strong>{l.label}</strong><small>{l.detail}</small></span>
            <Icon name="open_in_new" size={20} />
          </a>
        </li>
      ))}
    </ul>
  </article>
</Base>

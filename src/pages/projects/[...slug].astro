---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Playground from '../../components/Playground.astro';
import Icon from '../../components/Icon.astro';
import { getProjects } from '../../lib/queries.js';
import { withBase, formatDate } from '../../lib/content.js';
import { projectLd } from '../../lib/seo.js';
import site from '../../../site.config.js';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, date, demo, source, link, cover } = project.data;
const base = import.meta.env.BASE_URL;
const url = new URL(Astro.url.pathname, Astro.site).href;
const ld = projectLd({ title, summary, date, url, source, tags, image: cover && new URL(withBase(cover, base), Astro.site).href, author: site.author });
---
<Base title={title} description={summary} image={cover} type="article" jsonLd={[ld]}>
  <article class="article article--project">
    <header class="article-header">
      <a class="back-link" href={withBase('/projects/', base)}><Icon name="arrow-left" size={16} />Projects</a>
      <h1 data-reveal>{title}</h1>
      <p class="lede" data-reveal>{summary}</p>
      <div class="meta" data-reveal>
        <span><Icon name="calendar" size={15} />{formatDate(date)}</span>
        {tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      {(source || link) && (
        <div class="article-actions" data-reveal>
          {link && <a class="btn" href={link}>Visit<Icon name="arrow-up-right" size={16} /></a>}
          {source && <a class="btn btn-secondary" href={source}><Icon name="github" size={16} />View source</a>}
        </div>
      )}
    </header>
    {demo && <Playground demo={demo} title={title} />}
    {!demo && cover && <img class="article-cover" src={withBase(cover, base)} alt="" />}
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>

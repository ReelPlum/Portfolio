---
import Base from '../layouts/Base.astro';
import PostFeed from '../components/PostFeed.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Icon from '../components/Icon.astro';
import site from '../../site.config.js';
import { getAllPosts, tagConfig } from '../lib/queries.js';
import { homeSections } from '../lib/tags.js';
import { withBase } from '../lib/content.js';
import { personLd, websiteLd } from '../lib/seo.js';
const base = import.meta.env.BASE_URL;
// The feeds below the intro come from `tags.home` in site.config.js.
const sections = homeSections(await getAllPosts(), tagConfig);
const home = new URL(base, Astro.site).href;
---
<Base jsonLd={[websiteLd(site, home), personLd(site, home)]}>
  <section class="hero">
    <p class="hero-eyebrow">Hi, I'm {site.author}.</p>
    <h1 class="hero-title">{site.tagline}</h1>
    <div class="hero-actions">
      <a class="btn" href={withBase('/projects/', base)}><Icon name="code" size={18} />See my work</a>
      <a class="btn btn-tonal" href={withBase('/contact/', base)}><Icon name="mail" size={18} />Get in touch</a>
    </div>
  </section>

  {sections.map((section) => (
    <section class:list={['section', { 'section-featured': section.layout === 'large' }]}>
      <SectionHeader title={section.title} href={section.link} />
      <PostFeed posts={section.posts} layout={section.layout} />
    </section>
  ))}
</Base>

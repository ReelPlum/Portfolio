---
// /tags/<tag>/: every post with that tag, newest first. Turn off with `tagPages: false` in site.config.js.
import FeedView from '../../components/views/FeedView.astro';
import { getAllPosts, tagConfig } from '../../lib/queries.js';
import { tagCounts, postsWithTag } from '../../lib/tags.js';
export async function getStaticPaths() {
  if (!tagConfig.tagPages) return [];
  const posts = await getAllPosts();
  return tagCounts(posts).map(({ tag, slug }) => ({ params: { tag: slug }, props: { tag, posts: postsWithTag(posts, slug) } }));
}
const { tag, posts } = Astro.props;
---
<FeedView title={`Tagged “${tag}”`} description={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}.`} posts={posts} layout="list" />

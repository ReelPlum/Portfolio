---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { withBase } from '../lib/content.js';
const base = import.meta.env.BASE_URL;
---
<Base title="Not found">
  <section class="hero hero--small">
    <p class="hero-eyebrow">404</p>
    <h1 class="hero-title">This page wandered off.</h1>
    <div class="hero-actions"><a class="btn" href={withBase('/', base)}><Icon name="arrow-left" size={16} />Back home</a></div>
  </section>
</Base>
